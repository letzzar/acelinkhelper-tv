<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d1a">

    <LinearLayout
        android:id="@+id/panel_favorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAVORITOS"
            android:textColor="#8098ff"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK para abrir · mantén OK para quitar"
            android:textColor="#8080a0"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <GridView
            android:id="@+id/gv_favorites"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="4"
            android:horizontalSpacing="14dp"
            android:verticalSpacing="14dp"
            android:listSelector="@drawable/tile_focus"
            android:drawSelectorOnTop="true"
            android:focusable="true"
            android:nextFocusDown="@+id/et_fav_name">

            <requestFocus />

        </GridView>

        <TextView
            android:id="@+id/tv_favorites_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aún no hay favoritos. Añade uno abajo o desde la interfaz web."
            android:textColor="#8080a0"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AÑADIR FAVORITO"
            android:textColor="#8098ff"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:gravity="center_vertical">

            <EditText
                android:background="@drawable/field_tv"
                android:id="@+id/et_fav_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nombre"
                android:inputType="text"
                android:textColor="#e0e0f0"
                android:textColorHint="#404060"
                android:textSize="18sp"
                android:padding="10dp"
                android:layout_marginEnd="12dp"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/gv_favorites"
                android:nextFocusRight="@+id/et_fav_url" />

            <EditText
                android:background="@drawable/field_tv"
                android:id="@+id/et_fav_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="ejemplo.com"
                android:inputType="textUri"
                android:textColor="#e0e0f0"
                android:textColorHint="#404060"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:layout_marginEnd="12dp"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/et_fav_name"
                android:nextFocusRight="@+id/btn_fav_add" />

            <Button
                android:id="@+id/btn_fav_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Añadir"
                android:textColor="#ffffff"
                android:background="@drawable/btn_tv"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:focusable="true"
                android:nextFocusLeft="@id/et_fav_url" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_add_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:minHeight="22dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/cursor"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/cursor"
        android:visibility="invisible" />

</FrameLayout>
